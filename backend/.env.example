# Azure AI Foundry resource endpoint, e.g. https://your-resource.services.ai.azure.com
# The portal often shows this with /openai/v1 appended — either form works, the
# backend strips the suffix before building the request URL.
AZURE_OPENAI_ENDPOINT=

# Key 1 or Key 2 from the "Keys and Endpoint" blade. A plain key is enough;
# the DefaultAzureCredential flow in the portal's sample code is not required.
AZURE_OPENAI_API_KEY=

# The DEPLOYMENT name from Foundry (e.g. gpt-5-mini), not the model family.
# Sent to Azure as the `model` field on the v1 surface.
AZURE_OPENAI_DEPLOYMENT=

# Optional. Completion budget, defaults to 2000.
# gpt-5 reasoning tokens are drawn from this same budget and are emitted BEFORE
# any visible text, so a value that is too low returns HTTP 200 with
# finish_reason "length" and empty content. See the README before lowering it.
AZURE_OPENAI_MAX_TOKENS=2000

# Optional and currently UNUSED — the v1 API surface takes no api-version.
# Kept only for anyone switching to the older /openai/deployments/... path.
# AZURE_OPENAI_API_VERSION=

# Local backend port
PORT=3001

# Allowed browser origin for CORS (Vite dev default)
CORS_ORIGIN=http://localhost:5173
