# Azure OpenAI resource endpoint, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Key 1 or Key 2 from the "Keys and Endpoint" blade
AZURE_OPENAI_API_KEY=

# The DEPLOYMENT name you chose in Azure AI Foundry (not the model name)
AZURE_OPENAI_DEPLOYMENT=

# Check the current supported version in the Azure portal for your deployment
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Local backend port
PORT=3001

# Allowed browser origin for CORS (Vite dev default)
CORS_ORIGIN=http://localhost:5173
